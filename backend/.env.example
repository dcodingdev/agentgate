# ==========================================
# AgentGate Environment Variables Configuration
# ==========================================

# Application Server
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=false

# LLM Providers
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
MODEL_NAME=gpt-4o

# Database Configuration (PostgreSQL + LangGraph Checkpointer)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentgate
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentgate
POSTGRES_PORT=5432

# Execution Sandbox (E2B)
E2B_API_KEY=e2b_your_api_key_here
E2B_TEMPLATE=base

# Tool Integrations & MCP
GITHUB_TOKEN=ghp_your_github_personal_access_token
TAVILY_API_KEY=tvly-your-tavily-api-key

# Guardrail & Safety Policies
ALLOWED_REPOS=["owner/repo1","owner/repo2"]
RISK_THRESHOLD_HIGH=0.7
AUTO_APPROVE_LOW_RISK=false
